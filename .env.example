# =============================================================
# Keepsy MVP — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file with real secrets.
# =============================================================

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# Public anon (or publishable) key — enables customer accounts (sign-in, saved
# designs, order history). Safe to expose; RLS protects the data. Without it
# the site works fully as guest-only and /account shows an honest notice.
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
# Server-only. Never NEXT_PUBLIC_, never imported by client code.
SUPABASE_SERVICE_ROLE_KEY=...
# Private Storage bucket used for generated designs / customer photos when
# CLOUDINARY_* is not set. Create it with: node scripts/setup-supabase-storage.mjs
SUPABASE_STORAGE_BUCKET=keepsy-images

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Image-generation model. Supported values: gpt-image-1, gpt-image-1.5,
# gpt-image-2, dall-e-3 (and other dall-e-* variants).
# The surrounding code auto-detects the DALL-E vs gpt-image family from
# the model name prefix and adjusts request body shape and size accordingly.
OPENAI_IMAGE_MODEL=gpt-image-1

# ── Upstash Redis (rate limiting) ─────────────────────────────
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# ── Resend (transactional email) ──────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=Keepsy <hello@keepsy.store>

# ── Site URLs ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://keepsy.store
SITE_URL=https://keepsy.store

# ── Printify ──────────────────────────────────────────────────
PRINTIFY_API_TOKEN=...
PRINTIFY_SHOP_ID=...
PRINTIFY_WEBHOOK_SECRET=...

# ── Cloudinary (image hosting for generated designs) ──────────
# Configure via individual vars OR CLOUDINARY_URL (not both)
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# ── Admin / Internal ──────────────────────────────────────────
MOCKUP_CALIBRATION_ENABLED=false
MOCKUP_CALIBRATION_KEY=...
PERF_DASHBOARD_KEY=...

# ── Founder notifications (Resend required) ───────────────────
FOUNDER_EMAIL_1=rory@keepsy.store
FOUNDER_EMAIL_2=dan@keepsy.store

# Keepsy Studio — confirmed Supabase Auth emails, comma-separated.
# No one has owner access when this is empty.
OWNER_EMAILS=

# Welcome discounts and CRM (server-only random secrets, at least 32 bytes).
WELCOME_CODE_SECRET=
CRM_IP_SALT=
# Keep false until migrations, verified Resend webhook and scheduled worker pass.
EMAIL_QUEUE_ENABLED=false
RESEND_WEBHOOK_SECRET=
CRON_SECRET=

# Web Push. Generate with: npx web-push generate-vapid-keys
# The PUBLIC key is exposed only by the authenticated owner setup endpoint.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@keepsy.store
